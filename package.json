{
  "name": "wam-sdk",
  "version": "0.0.13-fork.0",
  "description": "Unofficial fork of @webaudiomodules/sdk (Web Audio Modules 2.0 SDK), maintained by anouar-bm",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.d.ts",
  "scripts": {
    "prebuild": "node src/prebuild.js",
    "build": "esbuild src/index.js --target=esnext --bundle --sourcemap --outdir=dist --format=esm",
    "test": "jest",
    "test:browser": "npm run build && playwright test --project=chromium --project=firefox",
    "bench:micro": "node bench/micro.mjs",
    "bench:browser": "npm run build && node bench/run.mjs"
  },
  "keywords": [
    "webaudio",
    "webaudiomodules",
    "wam",
    "sdk"
  ],
  "author": "WebAudioModules Working Group",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anouar-bm/wam-sdk.git"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/jest": "^27.0.3",
    "dts-bundle-generator": "^6.2.0",
    "esbuild": "^0.14.2",
    "esbuild-jest": "^0.5.0",
    "jest": "^27.4.4",
    "typescript": "^4.5.3"
  },
  "module": "dist",
  "bugs": {
    "url": "https://github.com/anouar-bm/wam-sdk/issues"
  },
  "homepage": "https://github.com/anouar-bm/wam-sdk#readme",
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "wam-api": "^2.0.0-alpha.7-fork.0"
  }
}
