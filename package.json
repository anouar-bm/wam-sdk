{
  "name": "@webaudiomodules/sdk",
  "version": "0.0.12",
  "description": "WebAudioModules Plugin SDK",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.d.ts",
  "scripts": {
    "prebuild": "node src/prebuild.js",
    "build": "esbuild src/index.js --target=esnext --bundle --sourcemap --outdir=dist --format=esm",
    "typecheck": "tsc --noEmit -p .",
    "test": "jest",
    "test:browser": "npm run build && playwright test --project=chromium --project=firefox",
    "bench:micro": "node bench/micro.mjs",
    "bench:browser": "npm run build && node bench/run.mjs"
  },
  "keywords": [
    "webaudio",
    "webaudiomodules",
    "wam",
    "sdk"
  ],
  "author": "WebAudioModules Working Group",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/%40webaudiomodules/sdk.git"
  },
  "scriptPreprocessor": "node_modules/babel-jest",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@webaudiomodules/api": "^2.0.0-alpha.6",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "typescript": "^6.0.3"
  },
  "module": "dist",
  "bugs": {
    "url": "https://github.com/%40webaudiomodules/sdk/issues"
  },
  "homepage": "https://github.com/%40webaudiomodules/sdk#readme"
}
