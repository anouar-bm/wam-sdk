{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"strict": false,
		"moduleResolution": "bundler",
		"types": [],
		"target": "es2022",
		"module": "esnext",
		"allowSyntheticDefaultImports": true,
		"noEmit": true,
		"experimentalDecorators": true
	},
	"include": [
	  "src/**/*"
	],
	"exclude": [
	  "esm",
	  "node_modules",
	  "src/prebuild.js"
	]
}
